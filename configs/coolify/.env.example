# Example only. Do not commit the real /data/coolify/source/.env file.
# The official Coolify installer generates these values automatically.
# If you bootstrap manually, copy this file to /data/coolify/source/.env,
# replace every change-me value, and keep the final file on the server only.
#
# Safe random value helpers:
# - short random id/key: openssl rand -hex 16
# - long secret/password: openssl rand -hex 32
# - Laravel-style APP_KEY: printf 'base64:%s\n' "$(openssl rand -base64 32)"

# Application identity used by Coolify. Keep it stable after first deploy.
# Use any unique random hex string, for example: openssl rand -hex 16
APP_ID=change-me-random-hex

# Human-readable application name shown by Coolify and realtime services.
# Usually keep the default unless you intentionally rename the instance.
APP_NAME=Coolify

# Laravel/Coolify application encryption key.
# Generate once, keep it stable, and do not rotate casually because encrypted
# sessions/tokens can become invalid. Expected format starts with `base64:`.
APP_KEY=base64:change-me

# Runtime mode for the Coolify application. Use `production` on servers.
APP_ENV=production

# Host port exposed by Docker. The app inside the container still listens on 8080.
# Change this only if another service already uses port 8000 on the host.
APP_PORT=8000

# PostgreSQL database name used by the bundled postgres service.
# Keep `coolify` unless you need a custom existing database name.
DB_DATABASE=coolify

# PostgreSQL username used by both the app and postgres service.
# Usually keep this as `coolify`.
DB_USERNAME=coolify

# PostgreSQL password. Generate a long random secret and never reuse it elsewhere.
# Example: openssl rand -hex 32
DB_PASSWORD=change-me-long-random-secret

# Redis password used by both the app and redis service.
# Example: openssl rand -hex 32
REDIS_PASSWORD=change-me-long-random-secret

# Internal realtime/Soketi app id. Generate a stable random id.
# Example: openssl rand -hex 16
PUSHER_APP_ID=change-me-random-hex

# Internal realtime/Soketi app key. Generate a stable random key.
# Example: openssl rand -hex 16
PUSHER_APP_KEY=change-me-random-hex

# Internal realtime/Soketi secret. Generate a long random secret.
# Example: openssl rand -hex 32
PUSHER_APP_SECRET=change-me-long-random-secret

# Host port for the realtime/Soketi service. Keep 6001 unless it conflicts.
SOKETI_PORT=6001

# Enable only while debugging realtime issues. Keep false in normal operation.
SOKETI_DEBUG=false

# Bind address inside the realtime container. Keep 0.0.0.0 for Docker.
SOKETI_HOST=0.0.0.0

# Optional bootstrap root account values.
# Leave these blank unless you intentionally want to pre-seed the first admin.
# If set, use a real email address and a unique password from a password manager.
# Optional first-admin username. Leave blank to create the admin in the UI.
ROOT_USERNAME=

# Optional first-admin email. Leave blank unless pre-seeding ROOT_USERNAME too.
ROOT_USER_EMAIL=

# Optional first-admin password. If set, use a unique strong password.
ROOT_USER_PASSWORD=

# Container image registry. Keep ghcr.io for the official Coolify images.
# Change only if you mirror images through a private/internal registry.
REGISTRY_URL=ghcr.io

# Coolify image tag. Keep latest for normal installs, or pin a specific tag when
# you need controlled upgrades/rollbacks.
LATEST_IMAGE=latest

# PHP runtime tuning for the Coolify container. Defaults match docker-compose.yml.
# Increase PHP_MEMORY_LIMIT only if Coolify logs show memory pressure.
PHP_MEMORY_LIMIT=256M

# PHP-FPM process manager mode. Keep dynamic unless you know your workload needs static/ondemand.
PHP_FPM_PM_CONTROL=dynamic

# Initial PHP-FPM worker count when using dynamic process management.
PHP_FPM_PM_START_SERVERS=1

# Minimum idle PHP-FPM workers to keep available.
PHP_FPM_PM_MIN_SPARE_SERVERS=1

# Maximum idle PHP-FPM workers before PHP-FPM starts trimming them.
PHP_FPM_PM_MAX_SPARE_SERVERS=10

# Docker network address-pool settings used by Coolify-managed Docker networks.
# Keep the defaults unless they overlap with your LAN/VPN/Tailscale routes.
# If there is overlap, choose a private RFC1918 range that does not conflict.
DOCKER_ADDRESS_POOL_BASE=10.0.0.0/8

# Prefix size for networks carved from DOCKER_ADDRESS_POOL_BASE.
# 24 means each generated network is a /24 subnet.
DOCKER_ADDRESS_POOL_SIZE=24
